{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Pactum contract",
  "type": "object",
  "required": ["schema", "schema_version", "intent", "verification", "settlement", "parties"],
  "additionalProperties": false,
  "properties": {
    "schema": { "type": "string", "enum": ["pactum-contract/v1"] },
    "schema_version": { "type": "string", "pattern": "1.*" },
    "contract_id": { "type": "string", "pattern": "c-*" },
    "nonce": { "type": "string", "minLength": 1, "maxLength": 128 },
    "intent": {
      "type": "object",
      "required": ["type", "title", "source"],
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "pattern": "*.*", "minLength": 3, "maxLength": 128 },
        "domain": { "type": "string", "maxLength": 64 },
        "title": { "type": "string", "minLength": 3, "maxLength": 256 },
        "source": {
          "type": "object",
          "required": ["type"],
          "additionalProperties": false,
          "properties": {
            "type": { "type": "string", "enum": ["inline", "git", "url", "file"] },
            "data": { "type": "string" },
            "ref": { "type": "string" }
          }
        }
      }
    },
    "verification": {
      "type": "object",
      "required": ["tests"],
      "additionalProperties": false,
      "properties": {
        "tests": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "required": ["cmd"],
            "additionalProperties": false,
            "properties": {
              "cmd": { "type": "string", "minLength": 1, "maxLength": 1024 },
              "timeout_s": { "type": "integer", "minimum": 1, "maximum": 86400 }
            }
          }
        },
        "artifacts_expected": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "required": ["path"],
            "additionalProperties": false,
            "properties": {
              "path": { "type": "string", "minLength": 1, "maxLength": 256 },
              "min_size": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    },
    "settlement": {
      "type": "object",
      "required": ["provider", "budget", "on_success", "on_failure"],
      "additionalProperties": false,
      "properties": {
        "provider": { "type": "string", "minLength": 1, "maxLength": 64 },
        "budget": {
          "type": "object",
          "required": ["amount", "unit"],
          "additionalProperties": false,
          "properties": {
            "amount": { "type": "string", "pattern": "*.*" },
            "unit": { "type": "string", "minLength": 1, "maxLength": 16 }
          }
        },
        "on_success": { "type": "string", "enum": ["release_escrow"] },
        "on_failure": { "type": "string", "enum": ["refund"] },
        "royalty_split": {
          "type": "object",
          "required": ["principal", "executor"],
          "additionalProperties": false,
          "properties": {
            "principal": { "type": "integer", "minimum": 0, "maximum": 100 },
            "executor": { "type": "integer", "minimum": 0, "maximum": 100 }
          }
        },
        "auto_verify": { "type": "boolean" },
        "slash_stake_percent": { "type": "integer", "minimum": 0, "maximum": 100 }
      }
    },
    "parties": {
      "type": "object",
      "required": ["principal"],
      "additionalProperties": false,
      "properties": {
        "principal": { "type": "string", "minLength": 3 },
        "executor": { "type": ["string", "null"] }
      }
    },
    "deadline_utc": { "type": "string", "minLength": 20, "maxLength": 20 },
    "notes": { "type": "string", "maxLength": 2048 }
  }
}
